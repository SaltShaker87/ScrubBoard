Windows Registry Editor Version 5.00

; Optional Explorer *file* verb (v1). Selected-TEXT redaction itself uses the
; global hotkey (Ctrl+Shift+C) + tray app, since Explorer verbs only see files.
; Installer writes this under HKCU (no admin needed).
[HKEY_CURRENT_USER\Software\Classes\*\shell\PrivateCopy]
@="PrivateCopy (redact file text)"
"Icon"="\"C:\\Program Files\\PrivateCopy\\privatecopy.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\*\shell\PrivateCopy\command]
@="\"C:\\Program Files\\PrivateCopy\\privatecopy.exe\" run-once --file \"%1\""
