<?xml version="1.0" encoding="utf-8"?>
<!-- macOS Installer layout for Scrubboard.pkg (see build_pkg.sh). The pages come from
     scrubboard/texts.py via installer/render_texts.py. @ARCH@ is filled in at build time. -->
<installer-gui-script minSpecVersion="2">
    <title>Scrubboard</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.html" mime-type="text/html"/>
    <readme file="readme.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <background file="pkg-background.png" mime-type="image/png" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="pkg-background.png" mime-type="image/png" alignment="bottomleft" scaling="none"/>
    <options customize="never" require-scripts="false" hostArchitectures="@ARCH@"/>
    <os-version min="12.0"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="org.scrubboard.app"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="org.scrubboard.app" visible="false">
        <pkg-ref id="org.scrubboard.app"/>
    </choice>
    <pkg-ref id="org.scrubboard.app" onConclusion="none">Scrubboard-component.pkg</pkg-ref>
</installer-gui-script>
